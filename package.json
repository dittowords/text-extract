  },
  "devDependencies": {
    "@babel/core": "^7.11.4",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "babel-jest": "^29.3.1",
    "jest": "^29.3.1",
    "prettier": "^2.8.0",
    "typescript": "^5.8.3",
